<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Update check queries api.github.com from inside the host process. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Settings panel shows the module version; package visibility needs this on API 30+. -->
    <queries>
        <package android:name="io.github.fesht377.biliads" />
    </queries>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuckBiliAds"
        android:description="@string/xposed_description">
    </application>

</manifest>
